{
  "name": "yug-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/lab.mjs && vite",
    "build": "node scripts/lab.mjs && node scripts/check-links.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && node scripts/prerender.mjs && node scripts/check-placeholders.mjs",
    "lab:build": "node scripts/lab.mjs",
    "lab:refresh": "node scripts/lab.mjs --refresh",
    "check:links": "node scripts/check-links.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^7.3.7"
  }
}
